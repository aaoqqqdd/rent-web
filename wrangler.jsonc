{
	"$schema": "node_modules/wrangler/config-schema.json",
	// 独立的 Worker，与 rent 主应用分开部署。改这里不会影响 rent。
	"name": "geekslope-web",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-10",
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	// 只读复用 rent 的 D1 数据库，用于实时展示产品/联系方式。
	// database_id 与 ../wrangler.jsonc 中的 rent 库一致。
	"d1_databases": [
		{
			"binding": "RENT",
			"database_name": "rent",
			"database_id": "65a5ded3-ffd8-4627-8ea4-9d8ced480b93"
		}
	],
	"vars": {
		// rent 主应用的公开地址。营销站的「立即租赁」表单会 POST 到
		//   ${APP_URL}/public/rental-request
		// 并把返回的 /contract/sign 链接重定向给访客。部署后改成真实域名。
		"APP_URL": "https://rent.example.com",
		// 月租展示价 = 日租 × 该系数（取整）。仅用于官网展示，真实计费仍在 rent 内完成。
		"MONTHLY_MULTIPLIER": "20",
		// Cloudflare Turnstile 站点公钥（与 rent 主应用同一个 Turnstile 组件）。
		// 留空则「立即租赁」表单不显示人机验证；rent 侧未配置 TURNSTILE_SECRET_KEY 时也会放行。
		"TURNSTILE_SITE_KEY": ""
	}
	// 可选覆盖项（用 `wrangler secret put` 或在此加 vars）：
	//   CONTACT_PHONE / CONTACT_EMAIL —— 覆盖 systemSettings.companyDetails 里的联系方式
	//
	// rent 主应用侧需要相应配置（在 ../ 里）：
	//   PUBLIC_WEB_ORIGIN = 本站的部署 origin（如 https://geekslope-web.pages.dev），用于放行跨站下单请求
	//   PUBLIC_APP_URL    = rent 自身对外地址，用于拼签署链接（缺省用请求 origin）
}
